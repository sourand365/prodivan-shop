async function finalEarningsCheckGoal(
  ctx,
  userId,
  period
) {

  try {

    const data =
      await finalEarningsPeriodEntries(
        period
      );

    const item =
      data.result.find(
        x =>
          String(
            x.userId
          ) ===
          String(
            userId
          )
      );

    const goal =
      data.state.goals?.[
      period
      ]?.[
      String(userId)
      ];

    if (
      !goal ||
      goal.periodKey !==
      data.currentKey ||
      !(goal.target > 0)
    ) {

      return;
    }

    const total =
      item?.total || 0;

    const percent =
      finalEarningsGoalPercent(
        total,
        goal.target
      );

    if (
      percent >= 100 &&
      !goal.notified
    ) {

      goal.notified =
        true;

      data.state.goalNotified[
        period
      ][
        data.currentKey
      ] =
        data.state.goalNotified[
        period
        ][
        data.currentKey
        ] || {};

      data.state.goalNotified[
        period
      ][
        data.currentKey
      ][
        String(userId)
      ] =
        true;

      await finalEarningsSave(
        data.state
      );

      const label =
        period === "week"
          ? "НЕДЕЛИ"
          : "МЕСЯЦА";

      await ctx.reply(

        `🎉🎯 ЦЕЛЬ ${label} ВЫПОЛНЕНА!\n\n` +

        `👤 ${item?.name ||
        data.state.users?.[
          userId
        ]?.name ||
        "Курьер"
        }\n` +

        `💰 Заработано: ${total} грн\n` +

        `🎯 Цель: ${goal.target} грн\n` +

        `📊 Выполнено: ${percent}%\n\n` +

        `🔥 Цель выполнена!`
      );
    }

  } catch (error) {

    console.error(
      "GOAL CHECK ERROR:",
      error
    );
  }
}



bot.command("n", async ctx => {
  if (!isAdmin(ctx)) {
    await ctx.reply("Нет доступа ❌");
    return;
  }

  try {
    const args = ctx.message.text
      .trim()
      .split(/\s+/)
      .slice(1);

    if (args.length === 0) {
      await ctx.reply(
        "Использование:\n\n" +
        "/n Имя\n" +
        "/n пт Имя"
      );

      return;
    }

    let dayKey = getDayKey();
    let nameParts = args;

    const selectedDay =
      getDayByInput(args[0]);

    if (selectedDay) {
      dayKey = selectedDay.key;
      nameParts = args.slice(1);
    }

    const name =
      nameParts.join(" ").trim();

    if (!name) {
      await ctx.reply("Укажи имя ❌");
      return;
    }

    const state = await loadState();

    await ensureCurrentWeek(state);

    const people =
      state.currentWeek.days[dayKey] || [];

    if (people.length >= MAX_PEOPLE_PER_DAY) {
      await ctx.reply(
        `На ${DAYS.find(d => d.key === dayKey).name
        } уже назначено 2 человека ❌`
      );

      return;
    }

    const exists = people.some(
      person =>
        person.toLowerCase() ===
        name.toLowerCase()
    );

    if (exists) {
      await ctx.reply(
        `${name} уже назначен на этот день ⚠️\n\n` +
        `Для повторного назначения используй:\n` +
        `/nn ${name}`
      );

      return;
    }

    people.push(name);

    state.currentWeek.days[dayKey] =
      people;

    await saveState(state);

    const dayName =
      DAYS.find(d => d.key === dayKey).name;

    await ctx.reply(
      `✅ Назначен\n\n` +
      `👤 ${name}\n` +
      `📅 ${dayName}`
    );
  } catch (error) {
    console.error(
      "ASSIGN ERROR:",
      error
    );

    await ctx.reply(
      "Ошибка назначения ❌\n\n" +
      String(error.message || error)
    );
  }
});



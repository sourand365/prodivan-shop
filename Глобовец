async function finalEarningsSetGoal(
  ctx,
  period,
  amount
) {

  if (
    !Number.isFinite(amount) ||
    amount <= 0
  ) {

    await ctx.reply(
      "❌ Сумма цели должна быть больше 0 грн."
    );

    return;
  }

  const state =
    await finalEarningsLoad();

  const userId =
    finalEarningsGetUserId(
      state,
      ctx
    );

  const periodKey =
    finalEarningsCurrentPeriod(
      period
    );

  state.goals[period][userId] = {

    periodKey:

      periodKey,

    target:

      finalEarningsRound(
        amount
      ),

    notified:
      false
  };

  if (
    ctx.chat?.id
  ) {

    state.goalReportChatId =
      ctx.chat.id;
  }

  await finalEarningsSave(
    state
  );

  await ctx.reply(

    `🎯 Цель ${period === "week"
      ? "недели"
      : "месяца"
    } установлена\n\n` +

    `💰 ${finalEarningsRound(amount)} грн`
  );
}



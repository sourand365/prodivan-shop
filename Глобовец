      await ctx.reply(
        "Использование:\n\n" +
        "/u Имя\n" +
        "/u пт Имя"
      );

      return;
    }

    let dayKey = getDayKey();
    let nameParts = args;

    const selectedDay =
      getDayByInput(args[0]);

    if (selectedDay) {
      dayKey = selectedDay.key;
      nameParts = args.slice(1);
    }

    const name =
      nameParts.join(" ").trim();

    if (!name) {
      await ctx.reply("Укажи имя ❌");
      return;

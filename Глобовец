async function finalTeaTop(
  ctx,
  period
) {

  try {

    const state =
      await loadTipsState();

    await ensureTipsDay(
      state
    );

    const totals = {};


    function addTips(
      entries
    ) {

      for (
        const [
          userId,
          item
        ] of Object.entries(
          entries || {}
        )
      ) {

        if (!item) {
          continue;
        }

        const id =
          String(userId);

        if (!totals[id]) {

          totals[id] = {

            name:
              item.name ||
              "Неизвестный",

            amount:
              0
          };
        }

        if (item.name) {

          totals[id].name =
            item.name;
        }

        totals[id].amount +=
          Number(
            item.amount
          ) || 0;
      }
    }


    if (
      period === "day"
    ) {

      addTips(
        state.today
      );
    }


    if (
      period === "week"
    ) {

      const weekKey =
        getCurrentWeekKeyForTips();

      for (
        const day
        of state.archive || []
      ) {

        if (
          !day?.date
        ) {
          continue;
        }

        if (
          getTipsWeekKeyFromDateKey(
            day.date
          ) !== weekKey
        ) {
          continue;
        }

        addTips(
          day.tips
        );
      }

      if (
        getTipsWeekKeyFromDateKey(
          state.currentDate
        ) === weekKey
      ) {

        addTips(
          state.today
        );
      }
    }


    if (
      period === "month"
    ) {

      const monthKey =
        getTipsMonthKey(
          getTipsDateKey()
        );

      for (
        const day
        of state.archive || []
      ) {

        if (
          !day?.date
        ) {
          continue;
        }

        if (
          getTipsMonthKey(
            day.date
          ) !== monthKey
        ) {
          continue;
        }

        addTips(
          day.tips
        );
      }

      if (
        getTipsMonthKey(
          state.currentDate
        ) === monthKey
      ) {

        addTips(
          state.today
        );
      }
    }


    const entries =
      Object.values(
        totals
      )
        .filter(
          item =>
            item.amount > 0
        )
        .sort(
          (
            a,
            b
          ) =>
            b.amount -
            a.amount
        );


    let title =
      "☕ ТОП ЧАЕВЫХ";

    if (
      period === "week"
    ) {

      title =
        "☕ ТОП ЧАЕВЫХ ЗА НЕДЕЛЮ";
    }

    if (
      period === "month"
    ) {

      title =
        "☕ ТОП ЧАЕВЫХ ЗА МЕСЯЦ";
    }


    let text =
      title +
      "\n━━━━━━━━━━━━━━\n\n";


    if (
      entries.length === 0
    ) {

      text +=
        "Чаевых пока нет 😢";

    } else {

      entries.forEach(
        (
          item,
          index
        ) => {

          text +=
            `${index + 1}. ` +
            `${item.name} — ` +
            `${item.amount} грн\n`;
        }
      );
    }

    await ctx.reply(
      text
    );

  } catch (error) {

    console.error(
      "TOP TEA ERROR:",
      error
    );

    await ctx.reply(
      "❌ Ошибка формирования топа чаевых."
    );
  }
}



bot.command("nn", async ctx => {
  if (!isAdmin(ctx)) {
    await ctx.reply("Нет доступа ❌");
    return;
  }

  try {
    const args = ctx.message.text
      .trim()
      .split(/\s+/)
      .slice(1);

    if (args.length === 0) {
      await ctx.reply(
        "Использование:\n\n" +
        "/nn Имя\n" +
        "/nn пт Имя"
      );

      return;
    }

    let dayKey = getDayKey();
    let nameParts = args;

    const selectedDay =
      getDayByInput(args[0]);

    if (selectedDay) {
      dayKey = selectedDay.key;
      nameParts = args.slice(1);
    }

    const name =
      nameParts.join(" ").trim();

    if (!name) {
      await ctx.reply(
        "Укажи имя ❌"
      );

      return;
    }

    const state = await loadState();

    await ensureCurrentWeek(state);

    const people =
      state.currentWeek.days[dayKey] || [];

    const index = people.findIndex(
      person =>
        person
          .replace(
            /\s*х[23]\s*🔥?$/i,
            ""
          )
          .trim()
          .toLowerCase() ===
        name.toLowerCase()
    );

    if (index === -1) {
      await ctx.reply(
        `${name} ещё не назначен на этот день.\n` +
        `Сначала используй /n ${name}`
      );

      return;
    }

    const current = people[index];

    let multiplier = 1;

    if (/х3/i.test(current)) {
      multiplier = 3;
    } else if (/х2/i.test(current)) {
      multiplier = 2;
    }

    if (multiplier >= 3) {
      await ctx.reply(
        `🔥 ${name} уже имеет максимальное количество — х3`
      );

      return;
    }

    multiplier++;

    people[index] =
      `${name} х${multiplier} 🔥`;

    state.currentWeek.days[dayKey] =
      people;

    await saveState(state);

    const dayName =
      DAYS.find(d => d.key === dayKey).name;

    await ctx.reply(
      `🔥 ${name} теперь х${multiplier}\n` +
      `📅 ${dayName}`
    );
  } catch (error) {
    console.error(
      "NN ERROR:",
      error
    );

    await ctx.reply(
      "Ошибка дополнительного назначения ❌\n\n" +
      String(error.message || error)
    );
  }
});



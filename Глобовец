const TIPS_COLLECTION =
  "courier-tips-v1";

const TIPS_KEY = "main";


// ============================================================
// ИМЯ TELEGRAM
// ============================================================

function getTelegramDisplayName(ctx) {
  const user = ctx.from;

  if (!user) {
    return "Неизвестный";
  }

  let name = "";

  if (user.first_name) {
    name += user.first_name;
  }

  if (user.last_name) {
    name += " " + user.last_name;
  }

  name = name.trim();

  if (!name) {
    name =
      user.username ||
      "Неизвестный";
  }

  return name;
}


// ============================================================
// ДАТА ЧАЕВЫХ
// ============================================================

function getTipsDateKey() {
  const now = new Date();

  return new Intl.DateTimeFormat(
    "en-CA",
    {
      timeZone: TIMEZONE,
      year: "numeric",
      month: "2-digit",
      day: "2-digit"
    }
  ).format(now);
}


function getTipsWeekKeyFromDateKey(
  dateKey
) {
  const parts =
    String(dateKey)
      .split("-")
      .map(Number);

  if (
    parts.length !== 3 ||
    parts.some(
      v => !Number.isFinite(v)
    )
  ) {
    return dateKey;
  }

  const date =
    new Date(
      Date.UTC(
        parts[0],
        parts[1] - 1,
        parts[2]
      )
    );

  const day =
    date.getUTCDay();

  const diff =
    day === 0
      ? -6
      : 1 - day;

  date.setUTCDate(
    date.getUTCDate() + diff
  );

  return [
    date.getUTCFullYear(),
    String(
      date.getUTCMonth() + 1
    ).padStart(2, "0"),
    String(
      date.getUTCDate()
    ).padStart(2, "0")
  ].join("-");
}


function getTipsMonthKey(dateKey) {
  return String(dateKey).slice(0, 7);
}


function getCurrentWeekKeyForTips() {
  return getTipsWeekKeyFromDateKey(
    getTipsDateKey()
  );
}


// ============================================================
// БАЗА ЧАЕВЫХ
// ============================================================

async function loadTipsState() {
  const collection =
    db.collection(
      TIPS_COLLECTION
    );

  const doc =
    await collection.findOne({
      key: TIPS_KEY
    });

  if (!doc || !doc.data) {
    const state = {
      currentDate:
        getTipsDateKey(),

      today: {},

      // Старый архив сохраняем!
      archive: [],

      // Новый недельный архив.
      weeklyArchive: []
    };

    await collection.updateOne(
      {
        key: TIPS_KEY
      },
      {
        $set: {
          key: TIPS_KEY,
          data: state,
          updatedAt: Date.now()
        }
      },
      {
        upsert: true
      }
    );

    return state;
  }

  const state = doc.data;

  if (!state.currentDate) {
    state.currentDate =
      getTipsDateKey();
  }

  if (!state.today) {
    state.today = {};
  }

  if (!state.archive) {
    state.archive = [];
  }

  if (!state.weeklyArchive) {
    state.weeklyArchive = [];
  }

  // Миграция старого дневного
  // архива в недельный.
  ensureWeeklyTipsArchiveMigration(
    state
  );

  return state;
}


async function saveTipsState(state) {
  const collection =
    db.collection(
      TIPS_COLLECTION
    );

  await collection.updateOne(
    {
      key: TIPS_KEY
    },
    {
      $set: {
        key: TIPS_KEY,
        data: state,
        updatedAt: Date.now()
      }
    },
    {
      upsert: true
    }
  );
}


// ============================================================
// СОЗДАНИЕ НЕДЕЛЬНОГО АРХИВА ИЗ СТАРЫХ ДНЕЙ
// ============================================================

function buildWeeklyEntryFromDailyArchive(
  state,
  weekKey
) {
  const totals = {};

  for (
    const day of state.archive || []
  ) {
    if (!day || !day.date) {
      continue;
    }

    if (
      getTipsWeekKeyFromDateKey(
        day.date
      ) !== weekKey
    ) {
      continue;
    }

    for (
      const [
        userId,
        item
      ] of Object.entries(
        day.tips || {}
      )
    ) {
      if (!item) continue;

      if (!totals[userId]) {
        totals[userId] = {
          name:
            item.name ||
            "Неизвестный",
          amount: 0
        };
      }

      totals[userId].name =
        item.name ||
        totals[userId].name;

      totals[userId].amount +=
        Number(item.amount) || 0;
    }
  }

  return {
    weekKey,
    tips: totals
  };
}


function ensureWeeklyTipsArchiveMigration(
  state
) {
  if (!state.weeklyArchive) {
    state.weeklyArchive = [];
  }

  const existing =
    new Set(
      state.weeklyArchive
        .filter(
          w =>
            w &&
            w.weekKey
        )
        .map(
          w => w.weekKey
        )
    );

  const weekKeys =
    [
      ...new Set(
        (state.archive || [])
          .filter(
            d =>
              d &&
              d.date
          )
          .map(
            d =>
              getTipsWeekKeyFromDateKey(
                d.date
              )
          )
      )
    ];

  let changed = false;

  for (
    const weekKey of weekKeys
  ) {
    if (
      existing.has(weekKey)
    ) {
      continue;
    }

    state.weeklyArchive.push(
      buildWeeklyEntryFromDailyArchive(
        state,
        weekKey
      )
    );

    existing.add(
      weekKey
    );

    changed = true;
  }

  if (changed) {
    state.weeklyArchive.sort(
      (a, b) =>
        String(b.weekKey)
          .localeCompare(
            String(a.weekKey)
          )
    );
  }

  return changed;
}


// ============================================================
// ОБНОВЛЕНИЕ НЕДЕЛЬНОГО АРХИВА
// ============================================================

function rebuildWeeklyArchiveEntry(
  state,
  weekKey
) {
  const fresh =
    buildWeeklyEntryFromDailyArchive(
      state,
      weekKey
    );

  const index =
    state.weeklyArchive.findIndex(
      w =>
        w.weekKey ===
        weekKey
    );

  if (index === -1) {
    state.weeklyArchive.unshift(
      fresh
    );
  } else {
    state.weeklyArchive[index] =
      fresh;
  }
}


// ============================================================
// ПЕРЕХОД НА НОВЫЙ ДЕНЬ
// ============================================================

async function ensureTipsDay(state) {
  const today =
    getTipsDateKey();

  if (
    state.currentDate ===
    today
  ) {
    return false;
  }

  const oldDate =
    state.currentDate;

  const oldWeekKey =
    getTipsWeekKeyFromDateKey(
      oldDate
    );

  const newWeekKey =
    getTipsWeekKeyFromDateKey(
      today
    );

  // Старый день сохраняем.
  if (
    Object.keys(
      state.today || {}
    ).length > 0
  ) {
    state.archive.unshift({
      date:
        state.currentDate,

      tips:
        state.today
    });
  }

  // Если началась новая неделя —
  // создаём итог предыдущей недели.
  if (
    oldWeekKey !==
    newWeekKey
  ) {
    rebuildWeeklyArchiveEntry(
      state,
      oldWeekKey
    );
  }

  state.currentDate =
    today;

  state.today = {};

  // Старый дневной архив НЕ удаляем.
  // Это важно для "Чай все".

  // Недельный архив ограничиваем
  // двадцатью неделями.
  if (
    state.weeklyArchive.length >
    20
  ) {
    state.weeklyArchive =
      state.weeklyArchive.slice(
        0,
        20
      );
  }

  await saveTipsState(
    state
  );

  return true;
}



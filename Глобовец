    name: "Среда",
    short: "ср"
  },
  {
    key: "thu",
    name: "Четверг",
    short: "чт"
  },
  {
    key: "fri",
    name: "Пятница",
    short: "пт"
  },
  {
    key: "sat",
    name: "Суббота",
    short: "сб"
  },
  {
    key: "sun",
    name: "Воскресенье",
    short: "вс"
  }
];


function getDayKey(date = getNowKyiv()) {
  const day = date.getDay();

  if (day === 1) return "mon";
  if (day === 2) return "tue";
  if (day === 3) return "wed";
  if (day === 4) return "thu";
  if (day === 5) return "fri";
  if (day === 6) return "sat";

  return "sun";
}


function getDayByInput(value) {
  if (!value) return null;

  const v = String(value).toLowerCase();

  return DAYS.find(
    d =>
      d.key === v ||
      d.short === v ||
      d.name.toLowerCase() === v
  ) || null;
}


// ============================================================
// НЕДЕЛИ ТАБЛИЦЫ
// ============================================================

function createEmptyWeek(weekKey) {
  return {
    weekKey,
    createdAt: Date.now(),

    days: {
      mon: [],
      tue: [],
      wed: [],
      thu: [],
      fri: [],
      sat: [],
      sun: []
    }
  };
}


// ============================================================
// ОСНОВНАЯ БАЗА
// ============================================================

async function loadState() {
  const collection = db.collection(DB_COLLECTION);

  const doc = await collection.findOne({
    key: DB_KEY
  });

  if (!doc || !doc.data) {
    const state = {
      currentWeek: createEmptyWeek(getWeekKey()),
      archive: [],
      codes: {},
      initializedAt: Date.now()
    };

    await collection.updateOne(
      {
        key: DB_KEY
      },
      {
        $set: {
          key: DB_KEY,
          data: state,
          updatedAt: Date.now()
        }
      },
      {
        upsert: true
      }
    );

    return state;
  }

  const state = doc.data;

  if (!state.currentWeek) {
    state.currentWeek = createEmptyWeek(getWeekKey());
  }

  if (!state.archive) {
    state.archive = [];
  }

  if (!state.codes) {
    state.codes = {};
  }

  return state;
}


async function saveState(state) {
  const collection = db.collection(DB_COLLECTION);

  await collection.updateOne(
    {
      key: DB_KEY
    },
    {
      $set: {
        key: DB_KEY,
        data: state,
        updatedAt: Date.now()
      }
    },
    {
      upsert: true
    }
  );
}


// ============================================================
// АВТОМАТИЧЕСКАЯ СМЕНА НЕДЕЛИ
// ============================================================

async function ensureCurrentWeek(state) {
  const currentWeekKey = getWeekKey();

  if (!state.currentWeek) {
    state.currentWeek = createEmptyWeek(currentWeekKey);
    return true;
  }

  if (state.currentWeek.weekKey !== currentWeekKey) {
    const oldWeek = state.currentWeek;

    if (oldWeek && oldWeek.weekKey) {
      state.archive = state.archive || [];

      const exists = state.archive.some(
        w => w.weekKey === oldWeek.weekKey
      );

      if (!exists) {
        state.archive.unshift(oldWeek);
      }
    }

    state.currentWeek = createEmptyWeek(currentWeekKey);

    if (state.archive.length > 20) {
      state.archive = state.archive.slice(0, 20);
    }

    return true;
  }

  return false;
}



    try {

      if (
        !isAdmin(ctx)
      ) {

        await ctx.reply(
          "Нет доступа ❌"
        );

        return;
      }

      const today =
        finalEarningsToday();

      const parsed =
        finalEarningsParseDate(
          today
        );

      if (!parsed) {

        await ctx.reply(
          "❌ Не удалось определить дату."
        );

        return;
      }

      const dot =
        finalEarningsDotDate(
          parsed
        );

      const slash =
        finalEarningsSlashDate(
          parsed
        );

      const iso =
        finalEarningsISODate(
          parsed
        );

      const teaDot =
        await finalEarningsTeaForDate(
          dot
        );

      const teaSlash =
        await finalEarningsTeaForDate(
          slash
        );

      const teaISO =
        await finalEarningsTeaForDate(
          iso
        );


      function sumTea(
        data
      ) {

        return Object.values(
          data || {}
        ).reduce(
          (
            sum,
            item
          ) =>
            sum +
            (
              Number(
                item.amount
              ) || 0
            ),
          0
        );
      }


      const a =
        sumTea(
          teaDot
        );

      const b =
        sumTea(
          teaSlash
        );

      const c =
        sumTea(
          teaISO
        );

      const same =
        a === b &&
        b === c;


      await ctx.reply(

        "🧪 ТЕСТ ДАТ\n" +
        "━━━━━━━━━━━━━━\n\n" +

        `${dot} → ☕ ${a} грн\n` +

        `${slash} → ☕ ${b} грн\n` +

        `${iso} → ☕ ${c} грн\n\n` +

        "━━━━━━━━━━━━━━\n" +

        (
          same
            ? "✅ ВСЕ ТРИ ФОРМАТА СОВПАДАЮТ"
            : "❌ ФОРМАТЫ ОТЛИЧАЮТСЯ"
        )
      );

    } catch (error) {

      console.error(
        "TEST TOP ERROR:",
        error
      );

      await ctx.reply(
        "❌ Ошибка теста."
      );
    }
  }
);



async function finalEarningsPeriodEntries(
  period
) {

  const state =
    await finalEarningsLoad();

  const tipsState =
    await loadTipsState();

  await ensureTipsDay(
    tipsState
  );

  const now =
    finalEarningsParseDate(
      finalEarningsToday()
    );

  const currentKey =
    period === "week"
      ? finalEarningsWeekKey(now)
      : finalEarningsMonthKey(now);

  const totals = {};


  function add(
    id,
    name,
    glovo,
    bolt,
    ipost,
    bolttr,
    personal,
    quests,
    tea
  ) {

    id =
      String(id);

    if (!totals[id]) {

      totals[id] = {

        userId:
          id,

        name:
          name ||
          "Неизвестный",

        glovo:
          0,

        bolt:
          0,

        ipost:
          0,

        bolttr:
          0,

        personal:
          0,

        quests:
          0,

        tea:
          0
      };
    }

    if (name) {

      totals[id].name =
        name;
    }

    totals[id].glovo +=
      Number(glovo) || 0;

    totals[id].bolt +=
      Number(bolt) || 0;

    totals[id].ipost +=
      Number(ipost) || 0;

    totals[id].bolttr +=
      Number(bolttr) || 0;

    totals[id].personal +=
      Number(personal) || 0;

    totals[id].quests +=
      Number(quests) || 0;

    totals[id].tea +=
      Number(tea) || 0;
  }


  // ----------------------------------------------------------
  // ЗАРАБОТОК
  // ----------------------------------------------------------

  for (
    const [
      dateKey,
      day
    ] of Object.entries(
      state.days || {}
    )
  ) {

    const parsed =
      finalEarningsParseDate(
        dateKey
      );

    if (!parsed) {
      continue;
    }

    const key =
      period === "week"
        ? finalEarningsWeekKey(
          parsed
        )
        : finalEarningsMonthKey(
          parsed
        );

    if (
      key !== currentKey
    ) {
      continue;
    }

    for (
      const [
        id,
        item
      ] of Object.entries(
        day || {}
      )
    ) {

      if (!item) {
        continue;
      }

      add(

        id,

        item.name ||
        state.users?.[id]?.name ||
        "Неизвестный",

        item.glovo,

        item.bolt,

        Number(item.ipost) ||
        Number(item.iposr) ||
        0,

        item.bolttr,

        item.personal,

        item.quests,

        0
      );
    }
  }


  // ----------------------------------------------------------
  // ЧАЕВЫЕ
  // ----------------------------------------------------------

  const tipDays = [];

  if (
    tipsState.currentDate
  ) {

    tipDays.push({
      date:
        tipsState.currentDate,

      tips:
        tipsState.today || {}
    });
  }

  for (
    const day
    of tipsState.archive || []
  ) {

    if (
      day &&
      day.date
    ) {

      tipDays.push(
        day
      );
    }
  }


  for (
    const day
    of tipDays
  ) {

    const parsed =
      finalEarningsParseDate(
        day.date
      );

    if (!parsed) {
      continue;
    }

    const key =
      period === "week"
        ? finalEarningsWeekKey(
          parsed
        )
        : finalEarningsMonthKey(
          parsed
        );

    if (
      key !== currentKey
    ) {
      continue;
    }

    for (
      const [
        id,
        item
      ] of Object.entries(
        day.tips || {}
      )
    ) {

      if (!item) {
        continue;
      }

      add(
        id,

        item.name ||
        "Неизвестный",

        0,
        0,
        0,
        0,
        0,
        0,

        Number(
          item.amount
        ) || 0
      );
    }
  }


  const result =
    Object.values(
      totals
    )
      .map(
        item => ({

          ...item,

          total:
            item.glovo +
            item.bolt +
            item.ipost +
            item.bolttr +
            item.personal +
            item.quests +
            item.tea
        })
      )
      .filter(
        item =>
          item.total > 0 ||
          state.goals?.[period]?.[
            item.userId
          ]?.target > 0
      )
      .sort(
        (
          a,
          b
        ) =>
          b.total -
          a.total
      );

  return {
    result,
    state,
    currentKey
  };
}
// ============================================================
// 🎯 ЦЕЛИ
// ============================================================

function finalEarningsGoalPercent(
  total,
  target
) {

  if (
    !(target > 0)
  ) {
    return 0;
  }

  return Math.round(
    (
      Number(total) /
      Number(target)
    ) * 100
  );
}



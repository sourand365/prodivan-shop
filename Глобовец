async function finalEarningsFinalizeWeek() {

  try {

    const state =
      await finalEarningsLoad();

    const now =
      finalEarningsParseDate(
        finalEarningsToday()
      );

    if (!now) {
      return;
    }

    const monday =
      new Date(now);

    monday.setUTCDate(
      monday.getUTCDate() -
      7
    );

    const previousWeek =
      finalEarningsWeekKey(
        monday
      );

    if (
      state.goalHistory.week[
        previousWeek
      ]?.published
    ) {
      return;
    }

    const data =
      await finalEarningsPeriodEntriesForKey(
        "week",
        previousWeek,
        state
      );

    const lines = [];

    for (
      const [
        userId,
        goal
      ] of Object.entries(
        state.goals.week || {}
      )
    ) {

      if (
        !goal ||
        goal.periodKey !==
        previousWeek ||
        !(goal.target > 0)
      ) {
        continue;
      }

      const item =
        data.find(
          x =>
            String(
              x.userId
            ) ===
            String(
              userId
            )
        );

      const total =
        item?.total || 0;

      const percent =
        finalEarningsGoalPercent(
          total,
          goal.target
        );

      lines.push(
        `👤 ${item?.name ||
        state.users?.[
          userId
        ]?.name ||
        "Неизвестный"
        } — ${percent}% ` +
        `(${total}/${goal.target} грн)`
      );
    }

    state.goalHistory.week[
      previousWeek
    ] = {

      published:
        true,

      lines:
        lines
    };

    await finalEarningsSave(
      state
    );

    if (
      lines.length > 0 &&
      state.goalReportChatId
    ) {

      await bot.telegram.sendMessage(

        state.goalReportChatId,

        "🏁 ИТОГ НЕДЕЛЬНЫХ ЦЕЛЕЙ\n" +
        "━━━━━━━━━━━━━━\n\n" +

        lines.join(
          "\n"
        )
      );
    }

  } catch (error) {

    console.error(
      "FINALIZE WEEK ERROR:",
      error
    );
  }
}


// ============================================================
// ПОЛУЧЕНИЕ ПЕРИОДА ПО КОНКРЕТНОМУ КЛЮЧУ
// ============================================================

async function finalEarningsPeriodEntriesForKey(
  period,
  currentKey,
  state
) {

  const tipsState =
    await loadTipsState();

  await ensureTipsDay(
    tipsState
  );

  const totals = {};


  function add(
    id,
    name,
    glovo,
    bolt,
    ipost,
    bolttr,
    personal,
    quests,
    tea
  ) {

    id =
      String(id);

    if (!totals[id]) {

      totals[id] = {

        userId:
          id,

        name:
          name ||
          "Неизвестный",

        glovo:
          0,

        bolt:
          0,

        ipost:
          0,

        bolttr:
          0,

        personal:
          0,

        quests:
          0,

        tea:
          0
      };
    }

    if (name) {

      totals[id].name =
        name;
    }

    totals[id].glovo +=
      Number(glovo) || 0;

    totals[id].bolt +=
      Number(bolt) || 0;

    totals[id].ipost +=
      Number(ipost) || 0;

    totals[id].bolttr +=
      Number(bolttr) || 0;

    totals[id].personal +=
      Number(personal) || 0;

    totals[id].quests +=
      Number(quests) || 0;

    totals[id].tea +=
      Number(tea) || 0;
  }


  for (
    const [
      dateKey,
      day
    ] of Object.entries(
      state.days || {}
    )
  ) {

    const parsed =
      finalEarningsParseDate(
        dateKey
      );

    if (!parsed) {
      continue;
    }

    const key =
      period === "week"
        ? finalEarningsWeekKey(
          parsed
        )
        : finalEarningsMonthKey(
          parsed
        );

    if (
      key !== currentKey
    ) {
      continue;
    }

    for (
      const [
        id,
        item
      ] of Object.entries(
        day || {}
      )
    ) {

      if (!item) {
        continue;
      }

      add(

        id,

        item.name ||
        state.users?.[id]?.name ||
        "Неизвестный",

        item.glovo,

        item.bolt,

        Number(item.ipost) ||
        Number(item.iposr) ||
        0,

        item.bolttr,

        item.personal,

        item.quests,

        0
      );
    }
  }


  const tipDays = [];

  if (
    tipsState.currentDate
  ) {

    tipDays.push({
      date:
        tipsState.currentDate,

      tips:
        tipsState.today || {}
    });
  }

  for (
    const day
    of tipsState.archive || []
  ) {

    if (
      day?.date
    ) {

      tipDays.push(
        day
      );
    }
  }


  for (
    const day
    of tipDays
  ) {

    const parsed =
      finalEarningsParseDate(
        day.date
      );

    if (!parsed) {
      continue;
    }

    const key =
      period === "week"
        ? finalEarningsWeekKey(
          parsed
        )
        : finalEarningsMonthKey(
          parsed
        );

    if (
      key !== currentKey
    ) {
      continue;
    }

    for (
      const [
        id,
        item
      ] of Object.entries(
        day.tips || {}
      )
    ) {

      if (!item) {
        continue;
      }

      add(
        id,

        item.name ||
        "Неизвестный",

        0,
        0,
        0,
        0,
        0,
        0,

        item.amount
      );
    }
  }


  return Object.values(
    totals
  ).map(
    item => ({

      ...item,

      total:
        item.glovo +
        item.bolt +
        item.ipost +
        item.bolttr +
        item.personal +
        item.quests +
        item.tea
    })
  );
}


